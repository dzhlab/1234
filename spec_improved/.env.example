# =============================================================================
# RG SYSTEM - ENVIRONMENT VARIABLES
# =============================================================================
# Копируйте этот файл в `.env` и заполните значения для вашего окружения
# Copy this file to `.env` and fill in the values for your environment
#
# ВАЖНО: Никогда не коммитьте файл .env в Git!
# IMPORTANT: Never commit the .env file to Git!
# =============================================================================

# -----------------------------------------------------------------------------
# ОБЩИЕ НАСТРОЙКИ / GENERAL SETTINGS
# -----------------------------------------------------------------------------

# Окружение: development, staging, production
# Environment: development, staging, production
NODE_ENV=production

# Версия Node.js для сборки контейнеров
# Node.js version for building containers
NODE_VERSION=18

# -----------------------------------------------------------------------------
# ПОРТЫ / PORTS
# -----------------------------------------------------------------------------

# HTTP порт для Nginx
# HTTP port for Nginx
HTTP_PORT=80

# HTTPS порт для Nginx
# HTTPS port for Nginx
HTTPS_PORT=443

# Порт API сервера (внутренний)
# API server port (internal)
API_PORT=3000

# Порт WebSocket сервера (внутренний)
# WebSocket server port (internal)
WS_PORT=3001

# Порт PostgreSQL (внешний доступ)
# PostgreSQL port (external access)
DB_PORT=5432

# Порт Redis (внешний доступ)
# Redis port (external access)
REDIS_PORT=6379

# Порт Adminer (только для разработки)
# Adminer port (development only)
ADMINER_PORT=8080

# Порт Redis Commander (только для разработки)
# Redis Commander port (development only)
REDIS_COMMANDER_PORT=8081

# -----------------------------------------------------------------------------
# БАЗА ДАННЫХ POSTGRESQL / POSTGRESQL DATABASE
# -----------------------------------------------------------------------------

# Имя базы данных
# Database name
DB_NAME=rgsystem_db

# Пользователь базы данных
# Database user
DB_USER=rgsystem_user

# Пароль базы данных
# Database password
# ВНИМАНИЕ: Используйте сложный пароль в продакшене!
# WARNING: Use a strong password in production!
DB_PASSWORD=SecurePassword123!

# Минимальное количество соединений в пуле
# Minimum pool connections
DB_POOL_MIN=2

# Максимальное количество соединений в пуле
# Maximum pool connections
DB_POOL_MAX=10

# -----------------------------------------------------------------------------
# REDIS CACHE
# -----------------------------------------------------------------------------

# Пароль для Redis
# Redis password
# ВНИМАНИЕ: Используйте сложный пароль в продакшене!
# WARNING: Use a strong password in production!
REDIS_PASSWORD=RedisPassword123!

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------------------------------

# Секретный ключ для подписи JWT токенов
# Secret key for signing JWT tokens
# ВНИМАНИЕ: Сгенерируйте уникальный ключ для продакшена!
# WARNING: Generate a unique key for production!
# Команда для генерации: openssl rand -base64 64
# Generation command: openssl rand -base64 64
JWT_SECRET=YourSuperSecretJWTKey123!ChangeThisInProduction

# Время жизни access token (например: 1h, 30m, 3600)
# Access token expiration time (e.g.: 1h, 30m, 3600)
JWT_EXPIRES_IN=1h

# Время жизни refresh token (например: 7d, 168h, 604800)
# Refresh token expiration time (e.g.: 7d, 168h, 604800)
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# API НАСТРОЙКИ / API SETTINGS
# -----------------------------------------------------------------------------

# Лимит запросов в час на один IP
# Request limit per hour per IP
API_RATE_LIMIT=1000

# Окно времени для подсчета запросов (в миллисекундах)
# Time window for counting requests (in milliseconds)
# 3600000 ms = 1 час / 1 hour
API_RATE_WINDOW=3600000

# -----------------------------------------------------------------------------
# ЛОГИРОВАНИЕ / LOGGING
# -----------------------------------------------------------------------------

# Уровень логирования: error, warn, info, http, verbose, debug, silly
# Logging level: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# WEBSOCKET НАСТРОЙКИ / WEBSOCKET SETTINGS
# -----------------------------------------------------------------------------

# Интервал ping сообщений (в миллисекундах)
# Ping message interval (in milliseconds)
WS_PING_INTERVAL=30000

# Таймаут ожидания pong (в миллисекундах)
# Pong timeout (in milliseconds)
WS_PING_TIMEOUT=5000

# Максимальное количество одновременных WebSocket соединений
# Maximum concurrent WebSocket connections
WS_MAX_CONNECTIONS=1000

# -----------------------------------------------------------------------------
# БЕЗОПАСНОСТЬ / SECURITY
# -----------------------------------------------------------------------------

# Разрешенные домены для CORS (разделенные запятой)
# Allowed domains for CORS (comma-separated)
# Пример / Example: https://example.com,https://app.example.com
CORS_ORIGINS=*

# Включить HTTPS редирект (true/false)
# Enable HTTPS redirect (true/false)
FORCE_HTTPS=true

# -----------------------------------------------------------------------------
# РЕЗЕРВНОЕ КОПИРОВАНИЕ / BACKUP
# -----------------------------------------------------------------------------

# Путь для сохранения резервных копий
# Path for storing backups
BACKUP_PATH=/var/backups/rgsystem

# Максимальное количество хранимых резервных копий
# Maximum number of stored backups
BACKUP_RETENTION=30

# Расписание полного бэкапа (cron формат)
# Full backup schedule (cron format)
# Каждое воскресенье в 02:00 / Every Sunday at 02:00
BACKUP_FULL_SCHEDULE=0 2 * * 0

# Расписание инкрементного бэкапа (cron формат)
# Incremental backup schedule (cron format)
# Каждый день в 03:00 / Every day at 03:00
BACKUP_INCREMENTAL_SCHEDULE=0 3 * * *

# -----------------------------------------------------------------------------
# SMTP / EMAIL (опционально)
# -----------------------------------------------------------------------------

# SMTP хост для отправки email уведомлений
# SMTP host for sending email notifications
SMTP_HOST=smtp.gmail.com

# SMTP порт
# SMTP port
SMTP_PORT=587

# SMTP пользователь
# SMTP user
SMTP_USER=your-email@gmail.com

# SMTP пароль
# SMTP password
SMTP_PASSWORD=your-smtp-password

# Email отправителя
# Sender email
SMTP_FROM=noreply@rgsystem.local

# -----------------------------------------------------------------------------
# МОНИТОРИНГ / MONITORING (опционально)
# -----------------------------------------------------------------------------

# Включить сбор метрик Prometheus (true/false)
# Enable Prometheus metrics collection (true/false)
ENABLE_METRICS=false

# Порт для метрик Prometheus
# Prometheus metrics port
METRICS_PORT=9090

# Включить health check endpoints (true/false)
# Enable health check endpoints (true/false)
ENABLE_HEALTH_CHECKS=true

# -----------------------------------------------------------------------------
# ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ / ADDITIONAL SETTINGS
# -----------------------------------------------------------------------------

# Максимальный размер загружаемых файлов (в МБ)
# Maximum upload file size (in MB)
MAX_UPLOAD_SIZE=10

# Разрешенные типы файлов для загрузки (разделенные запятой)
# Allowed file types for upload (comma-separated)
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Часовой пояс (для логов и расписаний)
# Timezone (for logs and schedules)
TZ=Europe/Moscow

# Язык по умолчанию (ru, en)
# Default language (ru, en)
DEFAULT_LANGUAGE=ru

# -----------------------------------------------------------------------------
# РАЗРАБОТКА / DEVELOPMENT
# -----------------------------------------------------------------------------

# Включить горячую перезагрузку (только для разработки)
# Enable hot reload (development only)
HOT_RELOAD=false

# Включить подробное логирование SQL запросов (только для разработки)
# Enable verbose SQL query logging (development only)
LOG_SQL_QUERIES=false

# Включить инструменты разработки (Adminer, Redis Commander)
# Enable development tools (Adminer, Redis Commander)
# Используйте: docker-compose --profile dev up
# Use: docker-compose --profile dev up
ENABLE_DEV_TOOLS=false

# -----------------------------------------------------------------------------
# КОНЕЦ ФАЙЛА / END OF FILE
# -----------------------------------------------------------------------------
